{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "experimentalServices": {
    "vulntrack-pro-api": {
      "type": "web",
      "root": "backend",
      "entrypoint": "app.main:app",
      "routePrefix": "/",
      "buildCommand": "pip install -r requirements.txt"
    }
  }
}
